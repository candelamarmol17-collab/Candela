{
  "name": "bandeja-priorizada-telesalud",
  "version": "0.1.0",
  "description": "MVP: bandeja priorizada de solicitudes de Telesalud con sugerencias de IA (solo datos sintéticos).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "iniciar": "node src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "revision:csv": "node scripts/generar-csv-revision.js",
