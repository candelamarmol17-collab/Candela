    "exportar:diseno": "node scripts/exportar-diseno.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^4.6.7"
  }
