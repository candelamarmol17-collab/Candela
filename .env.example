# Copia este archivo como .env y completa lo que falte.
# Nunca subas el archivo .env a git (ya está en .gitignore).

# ── Modo de la IA ────────────────────────────────────────────────
# Vacío: se usa el modelo real SOLO si IA_API_KEY tiene una clave; si no, el modo simulado.
# "simulado": fuerza el modo simulado por reglas fijas, aunque haya clave (regla R5).
# "repeticion": repite una corrida real guardada (ver IA_ARCHIVO_REPETICION).
MODO_IA=

# ── Proveedor compatible con OpenAI ──────────────────────────────
# NVIDIA (build.nvidia.com). Para otro proveedor, cambia la URL y el modelo.
# Los modelos del catálogo pueden retirarse: revisa los disponibles con "npm run ia:modelos".
IA_URL_BASE=https://integrate.api.nvidia.com/v1
IA_MODELO=mistralai/mistral-large-4-1t-a52b

# Pega tu clave después del signo igual, sin comillas ni espacios.
IA_API_KEY=

# ── Ritmo de las consultas (milisegundos) ────────────────────────
# Pausa entre una solicitud y la siguiente, para respetar los límites de uso.
IA_PAUSA_MS=2000
# Tiempo máximo de espera por cada respuesta (120000 = 2 minutos).
IA_TIEMPO_ESPERA_MS=120000

# ── Largo de la respuesta ────────────────────────────────────────
# Máximo de tokens (pedacitos de texto) que puede escribir el modelo, incluido lo que
# "piensa" antes de responder. Con menos de 4000, varios modelos se quedan sin respuesta.
IA_MAX_TOKENS=4000

# ── Repetición de una corrida guardada (solo con MODO_IA=repeticion) ──
# Ejemplo (corrida usada en el video): data/resultados/clasificaciones-minimaxai-minimax-m3.1-flash.json
IA_ARCHIVO_REPETICION=

# ── Aplicación ───────────────────────────────────────────────────
# Puerto donde se abre la aplicación.
PUERTO=3000

# Corrida guardada que muestra la bandeja (archivo .json de data/resultados/).
# Vacío = la corrida de MiniMax, que es la que se usa en el video.
BANDEJA_ARCHIVO_CORRIDA=
